  "wgame": true,
  "ctile": true,
  "game_talk": [
    "방금 타일이 인사하고 갔어.",
    "다 어디로 간 걸까?",
    "잘했어. 아마도.",
    "타일이 나한테 고맙대.",
    "손가락이 혼자 움직였어.",
    "이겼나? 진 건 아니야.",
    "숫자가 늘어나는 소리 들렸어?"
  ],
  "game_talk_win": [
    "전부 사라졌어. 무서워.",
    "하나도 안 남았어… 대단해!",
    "타일이 전부 이사 갔어."
  ],
  "g2_talk": {
    "start": [
      "숫자들이 깨어났어.",
      "판이 나를 기다렸대.",
      "네모 안에 방이 열여섯 개.",
      "2랑 2가 아는 사이래."
    ],
    "move_none": [
      "벽이 나를 밀었어.",
      "그쪽은 어제 닫혔어.",
      "아무 일도 안 일어난 척.",
      "타일이 안 움직이기로 했대."
    ],
    "big": [
      "숫자가 자라는 소리 들려?",
      "128이 인사하고 갔어.",
      "방금 하나가 둘을 먹었어.",
      "커진 게 나를 봤어."
    ],
    "combo": [
      "셋이 한꺼번에 사라졌어.",
      "타일들이 약속을 했나 봐.",
      "한 번에 세 번 접혔어.",
      "숫자가 겹쳐서 하나가 됐어."
    ],
    "top": [
      "제일 큰 숫자가 태어났어.",
      "기록이 갱신됐대. 누가 그래?",
      "이 숫자는 처음 봐.",
      "숫자가 나보다 커졌어."
    ],
    "tight": [
      "빈칸이 다 어디 갔지.",
      "판이 숨을 참고 있어.",
      "자리가 스스로 없어졌어.",
      "좁아. 숫자들이 붐벼."
    ],
    "idle": [
      "시간아, 먼저 가.",
      "판이 너를 기다리는 중.",
      "천천히. 아직 안 사라져.",
      "생각이 몽글몽글 끓어."
    ],
    "near": [
      "1024가 눈을 떴어.",
      "절반의 절반의 절반.",
      "다음은 마지막 숫자야.",
      "숫자가 꿈을 꾸는 중."
    ],
    "win": [
      "2048이 태어났어.",
      "숫자가 끝까지 자랐어.",
      "해냈어. 아마도 진짜로.",
      "판이 고맙대."
    ],
    "over": [
      "숫자들이 잠들었어.",
      "끝났대. 다들 인사하고 갔어.",
      "괜찮아. 또 태어날 거야.",
      "다음 판은 다른 세계야."
    ]
  },
